## style note: the variables this script reads -- app_path, app_user,
## app_homedir, main_app_dir, wrapper_script, seccomp_filter, bwrap_args and
## the allow_* / shared_storage flags -- are set by sandbox-app-launcher in the
## ENVIRONMENT of the 'sudo ... bwrap-wrapper' invocation. shellcheck sees no
## assignment because there is none in this file; the contract lives in the
## caller.
##
## Under nounset a missing one now ABORTS instead of expanding to empty. For a
## confinement wrapper that is the safe direction: an unset seccomp_filter or
## bwrap_args previously became an empty argument and bwrap ran with weaker
## isolation than intended. Failing closed is the point.
##
## The sourced paths are built at run time from the app name, so shellcheck
## cannot resolve them either.
# shellcheck disable=SC2154,SC1090

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

## Exported by sandbox-app-launcher before it invokes this script, but the
## script is also reachable on its own -- and under nounset an unset read would
## abort the sandbox wrapper before it could launch anything.
if [ "${sandbox_app_launcher_debug:-}" = "true" ]; then
  set -x
fi

## TODO: update
xsession_d_file_list_executable=(
  "/etc/X11/Xsession.d/20torbrowser"
  "/etc/X11/Xsession.d/20uwt"
  "/etc/X11/Xsession.d/20whonix"
  "/etc/X11/Xsession.d/20whonix-welcome-page"
  "/etc/X11/Xsession.d/20software_rendering_in_vms"
  "/etc/X11/Xsession.d/40open_link_confirmation"
  "/etc/X11/Xsession.d/40open_link_confirmation_kde"
  "/etc/X11/Xsession.d/50anon-apps-config"
  "/etc/X11/Xsession.d/50default_editor"
  "/etc/X11/Xsession.d/50tb_default_browser"
  "/etc/X11/Xsession.d/50torbrowser_default_browser"
  "/etc/X11/Xsession.d/50security-misc"
)

xsession_d_file_list_existing=(
  "/etc/X11/Xsession.d/20qt-gnome-desktop-session-id"
  "/etc/X11/Xsession.d/20qt-x11-no-mitshm"
  "/etc/X11/Xsession.d/25xdg-qubes-settings"
)

for file_name in "${xsession_d_file_list_executable[@]}" ; do
  if [ -x "${file_name}" ]; then
    ## '|| true' for the same reason as dbus-launch below: these are
    ## THIRD-PARTY Xsession.d scripts, not written to run under errexit, and
    ## before R-010 a non-zero return from one was ignored. Letting one abort
    ## this script would stop the application from launching at all.
    source "${file_name}" || true
  fi
done

for file_name in "${xsession_d_file_list_existing[@]}" ; do
  if [ -e "${file_name}" ]; then
    source "${file_name}" || true
  fi
done

## '|| true' because R-010 adds errexit to a file that had NO strict mode at
## all. dbus-launch is optional here -- the point of this script is the exec
## below -- so without the guard a system where dbus-launch is missing or
## failing would stop launching every sandboxed application.
dbus-launch >/dev/null || true

"${app_path}" "${@}"
